#!/bin/bash
# wq-colorize - colour wq logs on the way to the screen (the log files themselves stay plain text).
#   tail -f logs/monitor.out | ./wq-colorize
#   ./wq-colorize < logs/alerts-*.log | less -R
# Plain pass-through when stdout is not a terminal or NO_COLOR is set. WQ_FORCE_COLOR=1 forces colour.
# Game output goes through here on its way to the terminal. Escape sequences in it can retitle the
# window, write to the clipboard (OSC 52) or redraw the screen to fake a verdict, so every control
# character except tab and newline is removed. Colours are added afterwards, by us. (Pipes and files
# get the text untouched: the log file keeps what the game really wrote.)
# C2 80..C2 9F are the UTF-8 forms of the C1 controls (0x9b is a one-character CSI, 0x9d an OSC): some terminals obey them
# Direction overrides and invisible characters are replaced by a visible marker (same set as lib-clean.sh).
STRIP='s/[\x01-\x08\x0b-\x1f\x7f]//g; s/\xc2[\x80-\x9f]//g; s/\xe2\x80[\xaa-\xae]|\xe2\x81[\xa6-\xa9]|\xd8\x9c/<bidi>/g; s/\xe2\x80[\x8b-\x8f\xa8\xa9]|\xe2\x81[\xa0-\xa4\xaa-\xaf]|\xef\xbb\xbf|\xc2\xad|\xe1\xa0\x8e|\xe2\xa0\x80|\xef\xbf[\xb9-\xbb]|\xf3\xa0[\x80-\x81][\x80-\xbf]/<hidden>/g'
if [ -n "${NO_COLOR:-}" ] || { [ ! -t 1 ] && [ -z "${WQ_FORCE_COLOR:-}" ]; }; then
  if [ -t 1 ]; then exec env LC_ALL=C sed -u -E "$STRIP"; fi
  exec cat
fi

read -r -d '' PROG <<'SED' || true
s/^( *)(\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8}\])/\1\x1b[2m\2\x1b[0m/
/\[ALERT\]/{
  s/\[ALERT\]/\x1b[1;97;41m ALERT \x1b[0;31m/
  s/$/\x1b[0m/
}
/\[WARN\]/{
  s/\[WARN\]/\x1b[1;30;43m WARN \x1b[0;33m/
  s/$/\x1b[0m/
}
s/\[INFO\]/\x1b[36m[INFO]\x1b[0m/
s/\[info\]/\x1b[36m[info]\x1b[0m/
s/\[ok\]/\x1b[32m[ok]\x1b[0m/
s/\[LEAK\]/\x1b[1;31m[LEAK]\x1b[0m/
s/(VERDICT: )(REVIEW NEEDED|LAUNCH BLOCKED|SANDBOX LEAK)/\1\x1b[1;31m\2\x1b[0m/
s/(VERDICT: )(OK, minor notes)/\1\x1b[1;33m\2\x1b[0m/
s/(VERDICT: )(CLEAN|OK|PASS)/\1\x1b[1;32m\2\x1b[0m/
s/^(FATAL|ERROR|Error)(:)/\x1b[1;31m\1\2\x1b[0m/
s/^(--- .* ---)$/\x1b[1;34m\1\x1b[0m/
s/^(-- .*)$/\x1b[1m\1\x1b[0m/
s/^(=+)$/\x1b[2m\1\x1b[0m/
s/^( *Quarantine Run Summary.*)$/\x1b[1m\1\x1b[0m/
SED
LC_ALL=C sed -u -E "$STRIP" | exec sed -u -E "$PROG"
