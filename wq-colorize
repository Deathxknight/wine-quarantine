#!/bin/bash
# wq-colorize - colour wq logs on the way to the screen (the log files themselves stay plain text).
#   tail -f logs/monitor.out | ./wq-colorize
#   ./wq-colorize < logs/alerts-*.log | less -R
# Plain pass-through when stdout is not a terminal or NO_COLOR is set. WQ_FORCE_COLOR=1 forces colour.
if [ -n "${NO_COLOR:-}" ] || { [ ! -t 1 ] && [ -z "${WQ_FORCE_COLOR:-}" ]; }; then exec cat; fi

read -r -d '' PROG <<'SED' || true
s/^( *)(\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8}\])/\1\x1b[2m\2\x1b[0m/
/\[ALERT\]/{
  s/\[ALERT\]/\x1b[1;97;41m ALERT \x1b[0;31m/
  s/$/\x1b[0m/
}
/\[WARN\]/{
  s/\[WARN\]/\x1b[1;30;43m WARN \x1b[0;33m/
  s/$/\x1b[0m/
}
s/\[INFO\]/\x1b[36m[INFO]\x1b[0m/
s/\[info\]/\x1b[36m[info]\x1b[0m/
s/\[ok\]/\x1b[32m[ok]\x1b[0m/
s/\[LEAK\]/\x1b[1;31m[LEAK]\x1b[0m/
s/(VERDICT: )(REVIEW NEEDED|LAUNCH BLOCKED|SANDBOX LEAK)/\1\x1b[1;31m\2\x1b[0m/
s/(VERDICT: )(OK, minor notes)/\1\x1b[1;33m\2\x1b[0m/
s/(VERDICT: )(CLEAN|OK|PASS)/\1\x1b[1;32m\2\x1b[0m/
s/^(FATAL|ERROR|Error)(:)/\x1b[1;31m\1\2\x1b[0m/
s/^(--- .* ---)$/\x1b[1;34m\1\x1b[0m/
s/^(-- .*)$/\x1b[1m\1\x1b[0m/
s/^(=+)$/\x1b[2m\1\x1b[0m/
s/^( *Quarantine Run Summary.*)$/\x1b[1m\1\x1b[0m/
SED
exec sed -u -E "$PROG"
